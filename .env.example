# PaceLab environment configuration
# Copy this file to .env and replace every placeholder.
# Never commit a real .env file.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# development | production | test
ENVIRONMENT=development

# Enable verbose SQL/app debug output. Must be false in production.
DEBUG=false

# Application version reported by /health (informational).
APP_VERSION=0.1.0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Used to derive production cookie flags and for future signed values.
# Generate a long random value for any deployed environment.
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# Fernet key for encrypting Strava OAuth tokens at rest (Phase 8).
# Not required to boot. Required to Connect Strava. Also reserved for future Garmin tokens.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Comma-separated hostnames accepted in production (TrustedHost).
# Production: your public host, e.g. example.com
# 127.0.0.1 and localhost are always allowed too (Docker healthchecks).
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
# Browser origin allowed to call the API. Do not use *.
# Local: http://localhost:5173
# Production: https://your-domain (must be https; same origin as Caddy)
FRONTEND_URL=http://localhost:5173

# Leave empty in development so the browser calls the Vite origin and Vite
# proxies /health and /api to the backend (avoids WSL/Windows localhost issues).
VITE_API_BASE_URL=

# Where the Vite dev server proxies API traffic. Local: 127.0.0.1; Compose: backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=pacelab
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=pacelab
POSTGRES_PORT=5432

# SQLAlchemy async URL.
# From the host (pytest, local alembic): use localhost.
# From the backend container: docker-compose overrides this to use host "postgres".
DATABASE_URL=postgresql+asyncpg://pacelab:change-me-dev-only@localhost:5432/pacelab

# -----------------------------------------------------------------------------
# HTTP / reverse proxy
# -----------------------------------------------------------------------------
# Comma-separated IPs allowed to set X-Forwarded-* headers (uvicorn).
# Local: 127.0.0.1. Production Compose: * (only Caddy can reach the API).
FORWARDED_ALLOW_IPS=127.0.0.1

# -----------------------------------------------------------------------------
# Transactional email (SMTP)
# -----------------------------------------------------------------------------
# Local/dev: leave SMTP_HOST empty. PaceLab uses an in-memory recording sender;
# verification and reset mail appear on Settings → Account.
# Production: required. The API refuses to boot without SMTP_HOST, SMTP_FROM,
# SMTP_USERNAME, and SMTP_PASSWORD. Do not use a personal Gmail inbox.
# Recommended: Resend (https://resend.com) SMTP:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=re_your_api_key
#   SMTP_FROM=PaceLab <noreply@your-domain>
# Postmark and Amazon SES document equivalent SMTP values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Production host (docker compose -f docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# Public hostname friends type in the browser (no scheme). Operator-owned.
# PACELAB_DOMAIN=example.com
# Let's Encrypt account email for Caddy (not the From: address).
# CADDY_ACME_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Garmin Connect Developer Program (deferred / unused)
# -----------------------------------------------------------------------------
# Official OAuth 2.0 credentials. Unused: the programme is not accepting new
# apps as of 2026-08. Do not invent endpoints or store user Garmin passwords.
# Garmin-recorded runs enter PaceLab via FIT upload (Phase 7).
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:8000/api/v1/garmin/callback

# -----------------------------------------------------------------------------
# Strava (Phase 8)
# -----------------------------------------------------------------------------
# Official OAuth 2.0. Register an API application at:
# https://www.strava.com/settings/api
# Authorization Callback Domain: localhost (development) or your public host
# (production, no https://). Redirect URI must match STRAVA_REDIRECT_URI exactly.
# Production example: https://your-domain/api/v1/strava/callback
# Not required to boot. Connecting also requires ENCRYPTION_KEY.
# Do not store Strava usernames or passwords. Scope requested: activity:read_all
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/strava/callback

# mock | garmin  (garmin is a stub; live OAuth is deferred. FIT upload is separate.)
ACTIVITY_PROVIDER=mock

# Optional override for `python -m app.db.seed` (development only).
# PACELAB_SEED_EMAIL=dev@example.com
# PACELAB_SEED_PASSWORD=pacelab-dev-local-only
