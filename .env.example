# PaceLab environment configuration
# Copy this file to .env and replace every placeholder.
# Never commit a real .env file.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# development | production | test
ENVIRONMENT=development

# Enable verbose SQL/app debug output. Must be false in production.
DEBUG=false

# Application version reported by /health (informational).
APP_VERSION=0.1.0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Used to derive production cookie flags and for future signed values.
# Generate a long random value for any deployed environment.
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# Fernet-compatible key for encrypting Garmin OAuth tokens at rest (Phase 7).
# Leave empty until then. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Comma-separated hostnames accepted in production (TrustedHost).
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
# Browser origin allowed to call the API. Do not use *.
FRONTEND_URL=http://localhost:5173

# Leave empty in development so the browser calls the Vite origin and Vite
# proxies /health and /api to the backend (avoids WSL/Windows localhost issues).
VITE_API_BASE_URL=

# Where the Vite dev server proxies API traffic. Local: 127.0.0.1; Compose: backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=pacelab
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=pacelab
POSTGRES_PORT=5432

# SQLAlchemy async URL.
# From the host (pytest, local alembic): use localhost.
# From the backend container: docker-compose overrides this to use host "postgres".
DATABASE_URL=postgresql+asyncpg://pacelab:change-me-dev-only@localhost:5432/pacelab

# -----------------------------------------------------------------------------
# HTTP / reverse proxy
# -----------------------------------------------------------------------------
# Comma-separated IPs allowed to set X-Forwarded-* headers.
# Behind a reverse proxy, set this to the proxy address (or "*" only if the
# proxy is the only path to the app).
FORWARDED_ALLOW_IPS=127.0.0.1

# -----------------------------------------------------------------------------
# Garmin Connect Developer Program (Phase 7)
# -----------------------------------------------------------------------------
# Official OAuth 2.0 credentials. Leave empty until Garmin developer access
# is granted. Do not invent endpoints or store user Garmin passwords.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:8000/api/v1/garmin/callback

# mock | garmin  (garmin is a stub until Phase 7)
ACTIVITY_PROVIDER=mock

# Optional override for `python -m app.db.seed` (development only).
# PACELAB_SEED_EMAIL=dev@example.com
# PACELAB_SEED_PASSWORD=pacelab-dev-local-only
